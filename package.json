    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "image-size": "^2.0.4",
    "mdsvex": "^0.12.7",
    "prettier": "^3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": ">=5.57.2",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.2",
