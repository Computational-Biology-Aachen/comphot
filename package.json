    "chart.js": "^4.5.1",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "svelte-chartjs": "^4.0.1",
    "svelte-katex": "^0.2.0",
    "wat-compiler": "^1.1.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
